#!/usr/bin/env python3
import sys
import os
import sqlite3
import json
import uuid
from datetime import datetime, date

DB_DIR = os.path.expanduser("~/Library/Application Support/ZenTask")
DB_PATH = os.path.join(DB_DIR, "tasks.db")
DOT_DIR = os.path.expanduser("~/.zentask")

def init_db():
    os.makedirs(DB_DIR, exist_ok=True)
    if not os.path.exists(DOT_DIR):
        try:
            os.symlink(DB_DIR, DOT_DIR)
        except Exception:
            pass

    conn = sqlite3.connect(DB_PATH, timeout=5.0)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("""
    CREATE TABLE IF NOT EXISTS tasks (
        id TEXT PRIMARY KEY,
        title TEXT NOT NULL,
        due_date TEXT,
        priority TEXT DEFAULT 'normal',
        status TEXT DEFAULT 'pending',
        subtasks_json TEXT DEFAULT '[]',
        tags_json TEXT DEFAULT '[]',
        created_at TEXT NOT NULL,
        completed_at TEXT
    );
    """)
    conn.commit()
    return conn

def add_task(title, due=None, priority="normal", subtasks=None, tags=None):
    conn = init_db()
    task_id = str(uuid.uuid4())
    created_at = datetime.now().isoformat()
    
    subtask_items = []
    if subtasks:
        for s in subtasks:
            s = s.strip()
            if s:
                subtask_items.append({"id": str(uuid.uuid4()), "title": s, "isDone": False})
    
    tag_items = [t.strip() for t in (tags or []) if t.strip()]

    cursor = conn.cursor()
    cursor.execute("""
    INSERT INTO tasks (id, title, due_date, priority, status, subtasks_json, tags_json, created_at)
    VALUES (?, ?, ?, ?, 'pending', ?, ?, ?)
    """, (task_id, title, due, priority, json.dumps(subtask_items, ensure_ascii=False), json.dumps(tag_items, ensure_ascii=False), created_at))
    conn.commit()
    conn.close()
    return task_id

def list_tasks(status=None):
    conn = init_db()
    cursor = conn.cursor()
    if status == "all":
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks ORDER BY created_at DESC")
    elif status == "completed":
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks WHERE status='completed' ORDER BY completed_at DESC")
    else:
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks WHERE status='pending' ORDER BY created_at DESC")
    
    rows = cursor.fetchall()
    conn.close()
    tasks = []
    for r in rows:
        tasks.append({
            "id": r[0],
            "title": r[1],
            "due_date": r[2],
            "priority": r[3],
            "status": r[4],
            "subtasks": json.loads(r[5] or "[]"),
            "tags": json.loads(r[6] or "[]"),
            "created_at": r[7],
            "completed_at": r[8]
        })
    return tasks

def complete_task(target):
    conn = init_db()
    cursor = conn.cursor()
    # Check if target is UUID or keyword
    cursor.execute("SELECT id, title FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title = row[0], row[1]
    completed_at = datetime.now().isoformat()
    cursor.execute("UPDATE tasks SET status='completed', completed_at=? WHERE id=?", (completed_at, task_id))
    conn.commit()
    conn.close()
    return (task_id, title)

def delete_task(target):
    conn = init_db()
    cursor = conn.cursor()
    cursor.execute("SELECT id, title FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title = row[0], row[1]
    cursor.execute("DELETE FROM tasks WHERE id=?", (task_id,))
    conn.commit()
    conn.close()
    return (task_id, title)

def add_subtasks_to_task(target, new_subtasks):
    conn = init_db()
    cursor = conn.cursor()
    cursor.execute("SELECT id, title, subtasks_json FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title, subtasks_json = row[0], row[1], row[2]
    current = json.loads(subtasks_json or "[]")
    for s in new_subtasks:
        s = s.strip()
        if s:
            current.append({"id": str(uuid.uuid4()), "title": s, "isDone": False})
    
    cursor.execute("UPDATE tasks SET subtasks_json=? WHERE id=?", (json.dumps(current, ensure_ascii=False), task_id))
    conn.commit()
    conn.close()
    return (task_id, title, len(current))

def print_help():
    print("""ZenTask CLI - คำสั่งสำหรับจัดการ Task และเชื่อมต่อ AI Harness
Usage:
  zentask add <title> [--due YYYY-MM-DD] [--priority low|normal|high|urgent] [--subtasks "s1, s2"] [--tags "t1, t2"]
  zentask list [--all | --completed] [--json]
  zentask done <id_or_keyword>
  zentask delete <id_or_keyword>
  zentask breakdown <id_or_keyword> <subtask1> <subtask2> ...

Examples:
  zentask add "เตรียมสไลด์นำเสนอ" --due today --priority high
  zentask add "วางแผนท่องเที่ยวญี่ปุ่น" --subtasks "จองตั๋ว, จองโรงแรม, แลกเงิน"
  zentask list
  zentask done "สไลด์"
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()

    if cmd in ["-h", "--help", "help"]:
        print_help()
        sys.exit(0)

    if cmd == "add":
        if len(sys.argv) < 3:
            print("Error: โปรดระบุชื่องาน เช่น: zentask add \"ตรวจงาน\"")
            sys.exit(1)
        
        title = sys.argv[2]
        due = None
        priority = "normal"
        subtasks = []
        tags = []

        i = 3
        while i < len(sys.argv):
            arg = sys.argv[i]
            if arg == "--due" and i + 1 < len(sys.argv):
                val = sys.argv[i+1].lower()
                if val == "today":
                    due = date.today().isoformat()
                elif val == "tomorrow":
                    due = date.fromordinal(date.today().toordinal() + 1).isoformat()
                else:
                    due = val
                i += 2
            elif arg == "--priority" and i + 1 < len(sys.argv):
                priority = sys.argv[i+1].lower()
                i += 2
            elif arg == "--subtasks" and i + 1 < len(sys.argv):
                subtasks = [s.strip() for s in sys.argv[i+1].split(",") if s.strip()]
                i += 2
            elif arg == "--tags" and i + 1 < len(sys.argv):
                tags = [t.strip() for t in sys.argv[i+1].split(",") if t.strip()]
                i += 2
            else:
                i += 1

        task_id = add_task(title, due=due, priority=priority, subtasks=subtasks, tags=tags)
        print(f"✓ เพิ่มงานสำเร็จ: {title} (ID: {task_id[:8]}...)")

    elif cmd == "list":
        status = "pending"
        is_json = "--json" in sys.argv
        if "--all" in sys.argv:
            status = "all"
        elif "--completed" in sys.argv:
            status = "completed"

        tasks = list_tasks(status=status)
        if is_json:
            print(json.dumps(tasks, ensure_ascii=False, indent=2))
        else:
            if not tasks:
                print("ไม่มีงานค้างอยู่ในขณะนี้ ✨")
                return
            print(f"--- ZenTask ({len(tasks)} รายการ) ---")
            for t in tasks:
                status_icon = "✓" if t["status"] == "completed" else "○"
                priority_mark = "!" if t["priority"] in ["high", "urgent"] else " "
                due_info = f" [กำหนด: {t['due_date'][:10]}]" if t["due_date"] else ""
                sub_info = f" ({len(t['subtasks'])} ข้อย่อย)" if t["subtasks"] else ""
                print(f"{status_icon} [{t['id'][:8]}] {priority_mark} {t['title']}{due_info}{sub_info}")
                for s in t.get("subtasks", []):
                    s_icon = "✓" if s["isDone"] else "-"
                    print(f"    {s_icon} {s['title']}")

    elif cmd == "done":
        if len(sys.argv) < 3:
            print("Error: โปรดระบุ ID หรือคำค้นหา เช่น: zentask done \"สไลด์\"")
            sys.exit(1)
        res = complete_task(sys.argv[2])
        if res:
            print(f"✓ ติ๊กงานสำเร็จ: {res[1]} (ID: {res[0][:8]}...)")
        else:
            print(f"✗ ไม่พบงานที่ตรงกับ: {sys.argv[2]}")

    elif cmd == "delete":
        if len(sys.argv) < 3:
            print("Error: โปรดระบุ ID หรือคำค้นหา เช่น: zentask delete \"สไลด์\"")
            sys.exit(1)
        res = delete_task(sys.argv[2])
        if res:
            print(f"🗑️ ลบงานสำเร็จ: {res[1]} (ID: {res[0][:8]}...)")
        else:
            print(f"✗ ไม่พบงานที่ตรงกับ: {sys.argv[2]}")

    elif cmd == "breakdown":
        if len(sys.argv) < 4:
            print("Error: zentask breakdown <id_or_keyword> <subtask1> <subtask2> ...")
            sys.exit(1)
        target = sys.argv[2]
        new_subtasks = sys.argv[3:]
        res = add_subtasks_to_task(target, new_subtasks)
        if res:
            print(f"✓ เพิ่ม {len(new_subtasks)} ขั้นตอนย่อยในงาน '{res[1]}' เรียบร้อย (รวม {res[2]} ข้อย่อย)")
        else:
            print(f"✗ ไม่พบงาน: {target}")

    else:
        print_help()

if __name__ == "__main__":
    main()

