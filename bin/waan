#!/usr/bin/env python3
import sys
import os
import sqlite3
import json
import uuid
import argparse
import subprocess
import signal
import time
from datetime import datetime, date

DB_DIR = os.path.expanduser("~/Library/Application Support/Waan")
DB_PATH = os.path.join(DB_DIR, "tasks.db")
DOT_DIR = os.path.expanduser("~/.waan")

def init_db():
    os.makedirs(DB_DIR, exist_ok=True)
    if not os.path.exists(DOT_DIR):
        try:
            os.symlink(DB_DIR, DOT_DIR)
        except Exception:
            pass

    conn = sqlite3.connect(DB_PATH, timeout=5.0)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("""
    CREATE TABLE IF NOT EXISTS tasks (
        id TEXT PRIMARY KEY,
        title TEXT NOT NULL,
        due_date TEXT,
        priority TEXT DEFAULT 'normal',
        status TEXT DEFAULT 'pending',
        subtasks_json TEXT DEFAULT '[]',
        tags_json TEXT DEFAULT '[]',
        created_at TEXT NOT NULL,
        completed_at TEXT
    );
    """)
    conn.commit()
    return conn

def add_task(title, due=None, priority="normal", subtasks=None, tags=None):
    conn = init_db()
    task_id = str(uuid.uuid4())
    created_at = datetime.now().isoformat()
    
    subtask_items = [{"id": str(uuid.uuid4()), "title": s.strip(), "isDone": False} for s in (subtasks or []) if s.strip()]
    
    tag_items = [t.strip() for t in (tags or []) if t.strip()]

    cursor = conn.cursor()
    cursor.execute("""
    INSERT INTO tasks (id, title, due_date, priority, status, subtasks_json, tags_json, created_at)
    VALUES (?, ?, ?, ?, 'pending', ?, ?, ?)
    """, (task_id, title, due, priority, json.dumps(subtask_items, ensure_ascii=False), json.dumps(tag_items, ensure_ascii=False), created_at))
    conn.commit()
    conn.close()
    return task_id

def list_tasks(status=None):
    conn = init_db()
    cursor = conn.cursor()
    if status == "all":
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks ORDER BY created_at DESC")
    elif status == "completed":
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks WHERE status='completed' ORDER BY completed_at DESC")
    else:
        cursor.execute("SELECT id, title, due_date, priority, status, subtasks_json, tags_json, created_at, completed_at FROM tasks WHERE status='pending' ORDER BY created_at DESC")
    
    rows = cursor.fetchall()
    conn.close()
    tasks = []
    for r in rows:
        tasks.append({
            "id": r[0],
            "title": r[1],
            "due_date": r[2],
            "priority": r[3],
            "status": r[4],
            "subtasks": json.loads(r[5] or "[]"),
            "tags": json.loads(r[6] or "[]"),
            "created_at": r[7],
            "completed_at": r[8]
        })
    return tasks

def complete_task(target):
    conn = init_db()
    cursor = conn.cursor()
    cursor.execute("SELECT id, title FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title = row[0], row[1]
    completed_at = datetime.now().isoformat()
    cursor.execute("UPDATE tasks SET status='completed', completed_at=? WHERE id=?", (completed_at, task_id))
    conn.commit()
    conn.close()
    return (task_id, title)

def delete_task(target):
    conn = init_db()
    cursor = conn.cursor()
    cursor.execute("SELECT id, title FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title = row[0], row[1]
    cursor.execute("DELETE FROM tasks WHERE id=?", (task_id,))
    conn.commit()
    conn.close()
    return (task_id, title)

def add_subtasks_to_task(target, new_subtasks):
    conn = init_db()
    cursor = conn.cursor()
    cursor.execute("SELECT id, title, subtasks_json FROM tasks WHERE id = ? OR title LIKE ? LIMIT 1", (target, f"%{target}%"))
    row = cursor.fetchone()
    if not row:
        conn.close()
        return None
    
    task_id, title, subtasks_json = row[0], row[1], row[2]
    current = json.loads(subtasks_json or "[]")
    current.extend({"id": str(uuid.uuid4()), "title": s.strip(), "isDone": False} for s in new_subtasks if s.strip())

    cursor.execute("UPDATE tasks SET subtasks_json=? WHERE id=?", (json.dumps(current, ensure_ascii=False), task_id))
    conn.commit()
    conn.close()
    return (task_id, title, len(current))

def resolve_due_date(val):
    if not val:
        return None
    due_map = {"today": date.today().isoformat(), "tomorrow": date.fromordinal(date.today().toordinal() + 1).isoformat()}
    return due_map.get(val.lower(), val)

def split_csv(val):
    if not val:
        return []
    return [s.strip() for s in val.split(",") if s.strip()]

def cmd_add(args):
    due = resolve_due_date(args.due)
    subtasks = split_csv(args.subtasks)
    tags = split_csv(args.tags)
    task_id = add_task(args.title, due=due, priority=args.priority, subtasks=subtasks, tags=tags)
    print(f"Task added: {args.title} (ID: {task_id[:8]}...)")

def print_task_item(t):
    status_icon = "[x]" if t["status"] == "completed" else "[ ]"
    priority_mark = "!" if t["priority"] in ["high", "urgent"] else " "
    due_info = f" [Due: {t['due_date'][:10]}]" if t["due_date"] else ""
    sub_info = f" ({len(t['subtasks'])} subtasks)" if t["subtasks"] else ""
    print(f"{status_icon} [{t['id'][:8]}] {priority_mark} {t['title']}{due_info}{sub_info}")
    for s in t.get("subtasks", []):
        s_icon = "[x]" if s["isDone"] else "[-]"
        print(f"    {s_icon} {s['title']}")

def cmd_list(args):
    if args.all:
        status = "all"
    elif args.completed:
        status = "completed"
    else:
        status = "pending"

    tasks = list_tasks(status=status)
    if args.json:
        print(json.dumps(tasks, ensure_ascii=False, indent=2))
        return

    if not tasks:
        print("No pending tasks found.")
        return

    print(f"--- Waan ({len(tasks)} tasks) ---")
    for t in tasks:
        print_task_item(t)

def cmd_done(args):
    res = complete_task(args.target)
    if res:
        print(f"Task completed: {res[1]} (ID: {res[0][:8]}...)")
    else:
        print(f"Task not found matching: {args.target}")

def cmd_delete(args):
    res = delete_task(args.target)
    if res:
        print(f"Task deleted: {res[1]} (ID: {res[0][:8]}...)")
    else:
        print(f"Task not found matching: {args.target}")

def cmd_breakdown(args):
    res = add_subtasks_to_task(args.target, args.subtasks)
    if res:
        print(f"Added {len(args.subtasks)} subtasks to '{res[1]}' (Total: {res[2]} subtasks)")
    else:
        print(f"Task not found: {args.target}")

def _get_mcp_pid(pid_file):
    if not os.path.exists(pid_file):
        return None
    try:
        with open(pid_file, "r") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None

def _is_pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False

def _find_mcp_script():
    base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    mcp_script = os.path.join(base_dir, "mcp_server.py")
    if os.path.exists(mcp_script):
        return mcp_script
    return os.path.expanduser("~/.waan/mcp_server.py")

def _handle_mcp_status(pid):
    if _is_pid_alive(pid):
        print(f"Waan MCP Server: Active (PID: {pid}, Port: 8765)")
    else:
        print("Waan MCP Server: Stopped")

def _handle_mcp_start(pid, port):
    if _is_pid_alive(pid):
        print(f"Waan MCP Server is already running (PID: {pid})")
        return

    mcp_script = _find_mcp_script()
    proc = subprocess.Popen([sys.executable, mcp_script, "--port", str(port)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.3)
    if proc.poll() is None:
        print(f"Waan MCP Server started on port {port} (PID: {proc.pid})")
    else:
        print("Failed to start Waan MCP Server")

def _kill_process_gracefully(pid):
    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.2)
        if _is_pid_alive(pid):
            os.kill(pid, signal.SIGKILL)
    except OSError:
        pass

def _handle_mcp_stop(pid_file, status_file, pid):
    if not _is_pid_alive(pid):
        print("Waan MCP Server is not running.")
        return

    _kill_process_gracefully(pid)
    try:
        if os.path.exists(pid_file):
            os.remove(pid_file)
    except OSError:
        pass

    try:
        with open(status_file, "w") as f:
            json.dump({"enabled": False, "running": False, "port": 8765, "pid": None}, f, indent=2)
    except OSError:
        pass

    print(f"Waan MCP Server (PID: {pid}) stopped.")

def cmd_mcp(args):
    action = args.action or "status"
    pid_file = os.path.join(DB_DIR, "mcp.pid")
    status_file = os.path.join(DB_DIR, "mcp_status.json")
    pid = _get_mcp_pid(pid_file)

    if action == "start":
        port = getattr(args, "port", None) or 8765
        _handle_mcp_start(pid, port)
    elif action == "stop":
        _handle_mcp_stop(pid_file, status_file, pid)
    else:
        _handle_mcp_status(pid)

TARGET_HELP = "Task ID or search keyword"

def build_parser():
    parser = argparse.ArgumentParser(
        prog="waan",
        description="Waan CLI - Task Management & AI Harness Integration Tool"
    )
    subparsers = parser.add_subparsers(dest="command")

    p_add = subparsers.add_parser("add", help="Add a new task")
    p_add.add_argument("title", help="Title of the task")
    p_add.add_argument("--due", help="Due date: today, tomorrow, or YYYY-MM-DD")
    p_add.add_argument("--priority", choices=["low", "normal", "high", "urgent"], default="normal")
    p_add.add_argument("--subtasks", help="Comma-separated subtasks")
    p_add.add_argument("--tags", help="Comma-separated tags")
    p_add.set_defaults(func=cmd_add)

    p_list = subparsers.add_parser("list", help="List tasks")
    p_list.add_argument("--all", action="store_true", help="List all tasks")
    p_list.add_argument("--completed", action="store_true", help="List completed tasks")
    p_list.add_argument("--json", action="store_true", help="Output in JSON format")
    p_list.set_defaults(func=cmd_list)

    p_done = subparsers.add_parser("done", help="Complete a task")
    p_done.add_argument("target", help=TARGET_HELP)
    p_done.set_defaults(func=cmd_done)

    p_delete = subparsers.add_parser("delete", help="Delete a task")
    p_delete.add_argument("target", help=TARGET_HELP)
    p_delete.set_defaults(func=cmd_delete)

    p_bd = subparsers.add_parser("breakdown", help="Add subtasks to an existing task")
    p_bd.add_argument("target", help=TARGET_HELP)
    p_bd.add_argument("subtasks", nargs="+", help="Subtasks to add")
    p_bd.set_defaults(func=cmd_breakdown)

    p_mcp = subparsers.add_parser("mcp", help="Manage MCP Server (start, stop, status)")
    p_mcp.add_argument("action", nargs="?", choices=["start", "stop", "status"], default="status", help="Action to perform")
    p_mcp.add_argument("--port", type=int, default=8765, help="Port to listen on (default: 8765)")
    p_mcp.set_defaults(func=cmd_mcp)

    return parser

def main():
    parser = build_parser()
    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(0)
    args.func(args)

if __name__ == "__main__":
    main()

